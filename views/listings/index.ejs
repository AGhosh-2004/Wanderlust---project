<!DOCTYPE html>
<html lang="en">
<%- include("../includes/header.ejs") %>
<style>
    :root {
        --brand-primary: #fe385c;
        --brand-primary-hover: #e00b41;
        --brand-gradient: linear-gradient(135deg, #fe385c 0%, #e00b41 50%, #ff5a5f 100%);
        --dark-surface: #0f172a;
        --dark-card: #1e293b;
        --light-bg: #f8fafc;
        --border-color: rgba(226, 232, 240, 0.85);
        --card-shadow: 0 8px 20px -4px rgba(0, 0, 0, 0.06), 0 4px 8px -2px rgba(0, 0, 0, 0.03);
        --card-shadow-hover: 0 20px 32px -8px rgba(0, 0, 0, 0.14), 0 8px 12px -4px rgba(0, 0, 0, 0.05);
        --radius-md: 16px;
        --radius-lg: 22px;
    }

    body {
        background-color: var(--light-bg);
        color: #1e293b;
        min-height: 100vh;
    }

    .index-main-wrapper {
        position: relative;
        top: 75px;
        padding-bottom: 90px;
    }

    /* Flash Message */
    .flash {
        position: fixed;
        top: 0;
        left: 50%;
        transform: translate(-50%, -150%);
        opacity: 0;
        transition: transform 0.4s cubic-bezier(0.18, 0.89, 0.32, 1.28), opacity 0.3s ease;
        width: fit-content;
        height: fit-content;
        background-color: var(--brand-primary);
        color: white;
        z-index: 10000;
        padding: 10px 24px;
        border-radius: 50px;
        font-weight: 500;
        box-shadow: 0 10px 25px rgba(254, 56, 92, 0.4);
        pointer-events: none;
    }

    .flash.show {
        transform: translate(-50%, 25px);
        opacity: 1;
        pointer-events: auto;
    }

    /* Filter & Categories Bar */
    .filters-bar-wrapper {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1.5rem;
        margin-bottom: 2rem;
        background: #ffffff;
        padding: 14px 20px;
        border-radius: var(--radius-lg);
        border: 1px solid var(--border-color);
        box-shadow: 0 4px 16px rgba(0, 0, 0, 0.03);
    }

    .categories-carousel {
        display: flex;
        align-items: center;
        gap: 22px;
        overflow-x: auto;
        scrollbar-width: none; /* Firefox */
        -ms-overflow-style: none; /* IE/Edge */
        padding: 4px 0;
        flex-grow: 1;
    }

    .categories-carousel::-webkit-scrollbar {
        display: none;
    }

    .category-filter-item {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 6px;
        color: #64748b;
        background: transparent;
        border: none;
        cursor: pointer;
        padding: 6px 10px;
        border-bottom: 2px solid transparent;
        transition: all 0.25s ease;
        white-space: nowrap;
        font-size: 0.82rem;
        font-weight: 600;
        text-decoration: none;
        flex-shrink: 0;
    }

    .category-filter-item i {
        font-size: 1.45rem;
        transition: transform 0.25s ease;
    }

    .category-filter-item:hover {
        color: #0f172a;
        border-bottom-color: #cbd5e1;
    }

    .category-filter-item:hover i {
        transform: scale(1.15);
    }

    .category-filter-item.active {
        color: var(--brand-primary);
        border-bottom-color: var(--brand-primary);
    }

    /* Tax Switch */
    .tax-toggle-box {
        display: flex;
        align-items: center;
        gap: 12px;
        border: 1px solid var(--border-color);
        padding: 8px 16px;
        border-radius: 50px;
        background: #f8fafc;
        flex-shrink: 0;
        font-size: 0.85rem;
        font-weight: 600;
        color: #334155;
    }

    .form-check-input:checked {
        background-color: var(--brand-primary);
        border-color: var(--brand-primary);
    }

    /* Top Subhead Bar */
    .index-headline-bar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 1.5rem;
        flex-wrap: wrap;
        gap: 12px;
    }

    .index-headline-bar h1 {
        font-size: 1.45rem;
        font-weight: 800;
        color: #0f172a;
        letter-spacing: -0.3px;
        margin: 0;
    }

    .stays-counter-badge {
        background: #ffffff;
        border: 1px solid var(--border-color);
        padding: 4px 14px;
        border-radius: 50px;
        font-size: 0.85rem;
        font-weight: 600;
        color: #64748b;
    }

    /* Search Bar */
    .index-search-group {
        position: relative;
        min-width: 280px;
    }

    .index-search-group input {
        border-radius: 50px;
        padding: 9px 16px 9px 40px;
        border: 1px solid var(--border-color);
        background: #ffffff;
        font-size: 0.88rem;
        width: 100%;
        transition: all 0.2s ease;
    }

    .index-search-group input:focus {
        outline: none;
        border-color: var(--brand-primary);
        box-shadow: 0 0 0 3px rgba(254, 56, 92, 0.15);
    }

    .index-search-group i {
        position: absolute;
        left: 14px;
        top: 50%;
        transform: translateY(-50%);
        color: #94a3b8;
        font-size: 1.05rem;
    }

    /* Listing Cards */
    .stay-grid-card {
        background: #ffffff;
        border-radius: var(--radius-md);
        border: 1px solid var(--border-color);
        overflow: hidden;
        box-shadow: var(--card-shadow);
        transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.35s cubic-bezier(0.16, 1, 0.3, 1);
        display: flex;
        flex-direction: column;
        height: 100%;
        position: relative;
        text-decoration: none;
        color: inherit;
    }

    .stay-grid-card:hover {
        transform: translateY(-6px);
        box-shadow: var(--card-shadow-hover);
        color: inherit;
    }

    .card-media-box {
        position: relative;
        width: 100%;
        height: 250px;
        overflow: hidden;
        background: #e2e8f0;
    }

    .card-media-box img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.5s ease;
    }

    .stay-grid-card:hover .card-media-box img {
        transform: scale(1.06);
    }

    .card-floating-location {
        position: absolute;
        bottom: 12px;
        left: 12px;
        background: rgba(15, 23, 42, 0.85);
        backdrop-filter: blur(8px);
        color: #ffffff;
        font-size: 0.78rem;
        font-weight: 600;
        padding: 5px 12px;
        border-radius: 50px;
        display: inline-flex;
        align-items: center;
        gap: 5px;
    }

    .card-favorite-btn {
        position: absolute;
        top: 12px;
        right: 12px;
        width: 36px;
        height: 36px;
        border-radius: 50%;
        background: rgba(255, 255, 255, 0.9);
        backdrop-filter: blur(6px);
        border: none;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #0f172a;
        font-size: 1.1rem;
        transition: all 0.2s ease;
        cursor: pointer;
        z-index: 2;
    }

    .card-favorite-btn:hover {
        transform: scale(1.15);
        color: #fe385c;
    }

    .card-favorite-btn.favorited {
        color: #fe385c;
    }

    .card-favorite-btn.favorited i::before {
        content: "\ee0e"; /* filled heart */
    }

    .card-info-box {
        padding: 1.25rem;
        display: flex;
        flex-direction: column;
        flex-grow: 1;
    }

    .card-title-row {
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        gap: 8px;
        margin-bottom: 0.35rem;
    }

    .card-stay-title {
        font-size: 1.05rem;
        font-weight: 700;
        color: #0f172a;
        margin: 0;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        flex-grow: 1;
    }

    .card-rating-tag {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        font-size: 0.88rem;
        font-weight: 700;
        color: #0f172a;
        flex-shrink: 0;
    }

    .card-rating-tag i {
        color: #f59e0b;
        font-size: 0.9rem;
    }

    .card-location-text {
        font-size: 0.88rem;
        color: #64748b;
        margin-bottom: 0.75rem;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .card-pricing-row {
        margin-top: auto;
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding-top: 0.75rem;
        border-top: 1px solid #f1f5f9;
    }

    .price-num {
        font-size: 1.15rem;
        font-weight: 800;
        color: #0f172a;
    }

    .price-unit {
        font-size: 0.85rem;
        color: #64748b;
        font-weight: 500;
    }

    .btn-explore-pill {
        background: #f1f5f9;
        color: #0f172a;
        border-radius: 50px;
        padding: 6px 14px;
        font-size: 0.82rem;
        font-weight: 700;
        display: inline-flex;
        align-items: center;
        gap: 4px;
        transition: all 0.2s ease;
        text-decoration: none;
    }

    .stay-grid-card:hover .btn-explore-pill {
        background: var(--brand-primary);
        color: #ffffff;
    }

    /* Empty State */
    .empty-stays-state {
        background: #ffffff;
        border-radius: var(--radius-lg);
        padding: 4.5rem 2rem;
        text-align: center;
        border: 2px dashed #cbd5e1;
        margin: 2rem 0;
    }

    .empty-stays-circle {
        width: 80px;
        height: 80px;
        border-radius: 50%;
        background: #fff1f2;
        color: var(--brand-primary);
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 2.4rem;
        margin-bottom: 1.25rem;
    }

    @media (max-width: 991px) {
        .filters-bar-wrapper {
            flex-direction: column;
            align-items: stretch;
            gap: 12px;
        }
        .tax-toggle-box {
            align-self: flex-start;
        }
    }

    @media (max-width: 576px) {
        .card-media-box {
            height: 210px;
        }
    }
</style>
<body>
    <%- include("../includes/navbar.ejs") %>

    <main class="container index-main-wrapper">
        <!-- Flash notifications -->
        <% if(success && success.length > 0) { %>
            <div class="flash" id="flash-success"><%= success %></div>
        <% } %>
        <% if(deleted && deleted.length > 0) { %>
            <div class="flash" id="flash-deleted"><%= deleted %></div>
        <% } %>

        <!-- Wanderlust Categories & Taxes Filter Bar -->
        <section class="filters-bar-wrapper" aria-label="Listing categories">
            <div class="categories-carousel" id="categoriesBar">
                <button type="button" class="category-filter-item active" onclick="filterByCategory('all', this)">
                    <i class="ri-fire-line"></i>
                    <span>Trending</span>
                </button>
                <button type="button" class="category-filter-item" onclick="filterByCategory('beach', this)">
                    <i class="ri-umbrella-line"></i>
                    <span>Beachfront</span>
                </button>
                <button type="button" class="category-filter-item" onclick="filterByCategory('mountain', this)">
                    <i class="ri-landscape-line"></i>
                    <span>Mountains</span>
                </button>
                <button type="button" class="category-filter-item" onclick="filterByCategory('city', this)">
                    <i class="ri-building-line"></i>
                    <span>Iconic Cities</span>
                </button>
                <button type="button" class="category-filter-item" onclick="filterByCategory('pool', this)">
                    <i class="ri-water-flash-line"></i>
                    <span>Amazing Pools</span>
                </button>
                <button type="button" class="category-filter-item" onclick="filterByCategory('castle', this)">
                    <i class="ri-ancient-gate-line"></i>
                    <span>Mansions</span>
                </button>
                <button type="button" class="category-filter-item" onclick="filterByCategory('cabin', this)">
                    <i class="ri-home-wifi-line"></i>
                    <span>Cabins</span>
                </button>
                <button type="button" class="category-filter-item" onclick="filterByCategory('camping', this)">
                    <i class="ri-tent-line"></i>
                    <span>Camping</span>
                </button>
                <button type="button" class="category-filter-item" onclick="filterByCategory('lake', this)">
                    <i class="ri-sailboat-line"></i>
                    <span>Lakefront</span>
                </button>
            </div>

            <!-- Tax display toggle -->
            <div class="tax-toggle-box">
                <div class="form-check form-switch mb-0">
                    <input class="form-check-input" type="checkbox" role="switch" id="taxSwitchToggle" onchange="toggleTaxes(this)">
                    <label class="form-check-label ms-1" for="taxSwitchToggle">Display total after taxes</label>
                </div>
            </div>
        </section>

        <!-- Subheader with Search & Counts -->
        <header class="index-headline-bar">
            <div class="d-flex align-items-center gap-3">
                <h1>Explore All Stays</h1>
                <span class="stays-counter-badge" id="listingCountBadge"><%= (lists && lists.length) ? lists.length : 0 %> stays available</span>
            </div>

            <div class="index-search-group">
                <i class="ri-search-line"></i>
                <input type="text" id="marketplaceSearchInput" placeholder="Search by title, city, or country..." onkeyup="filterMarketplaceListings()" value="<%= typeof searchQuery !== 'undefined' ? searchQuery : '' %>">
            </div>
        </header>

        <!-- Listings Grid -->
        <% if(!lists || lists.length === 0) { %>
            <div class="empty-stays-state">
                <div class="empty-stays-circle">
                    <i class="ri-compass-3-line"></i>
                </div>
                <h3 class="h4 fw-bold text-dark mb-2">No Stays Found</h3>
                <p class="text-muted mb-4">Be the first host to share an amazing property with travelers worldwide!</p>
                <a href="/listings/new" class="btn btn-danger rounded-pill px-4 py-2 fw-bold">
                    <i class="ri-add-line me-1"></i> Post a Stay
                </a>
            </div>
        <% } else { %>
            <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-xl-4 g-4" id="listingsGridContainer">
                <% for(let list of lists) { %>
                    <%
                        let imgUrl = list.imageurl || (typeof list.image === 'object' && list.image ? list.image.url : list.image) || "https://images.unsplash.com/photo-1501785888041-af3ef285b470?auto=format&fit=crop&w=800&q=80";
                        let basePrice = Number(list.price) || 0;
                        let withTaxPrice = Math.round(basePrice * 1.18);
                        let titleLower = (list.title || '').toLowerCase();
                        let locLower = (list.location || '').toLowerCase();
                        let countryLower = (list.country || '').toLowerCase();
                    %>
                    <div class="col listing-item-col" 
                         data-title="<%= titleLower %>" 
                         data-location="<%= locLower %>" 
                         data-country="<%= countryLower %>"
                         data-price="<%= basePrice %>">
                        <a href="/listings/<%= list._id %>" class="stay-grid-card">
                            <div class="card-media-box">
                                <img src="<%= imgUrl %>" alt="<%= list.title %>" loading="lazy">
                                <button type="button" class="card-favorite-btn" onclick="toggleFavorite(event, this)" title="Save to favorites">
                                    <i class="ri-heart-3-line"></i>
                                </button>
                                <span class="card-floating-location">
                                    <i class="ri-map-pin-2-fill text-danger"></i> <%= list.location %>, <%= list.country %>
                                </span>
                            </div>
                            <div class="card-info-box">
                                <div class="card-title-row">
                                    <h2 class="card-stay-title"><%= list.title %></h2>
                                    <span class="card-rating-tag">
                                        <i class="fa-solid fa-star"></i> 4.9
                                    </span>
                                </div>
                                <p class="card-location-text"><%= list.location %>, <%= list.country %></p>
                                <div class="card-pricing-row">
                                    <div>
                                        <span class="price-num base-price">&#8377; <%= basePrice.toLocaleString("en-in") %></span>
                                        <span class="price-num tax-price d-none">&#8377; <%= withTaxPrice.toLocaleString("en-in") %></span>
                                        <span class="price-unit">/ night</span>
                                    </div>
                                    <span class="btn-explore-pill">
                                        View <i class="ri-arrow-right-line"></i>
                                    </span>
                                </div>
                            </div>
                        </a>
                    </div>
                <% } %>
            </div>

            <!-- No search match banner -->
            <div id="noMatchMessage" class="empty-stays-state d-none">
                <i class="ri-search-eye-line fs-1 text-muted mb-2"></i>
                <h4 class="h5 fw-bold text-dark">No stays matched your search</h4>
                <p class="text-muted small mb-0">Try clearing your filters or searching for another destination.</p>
            </div>
        <% } %>
    </main>

    <!-- Scripts -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.15.0/gsap.min.js" integrity="sha512-oJ8QbaQThQoJZ7oEv+29jfPM6CcP+zUxh3PKJs1vyOhx0UraUrE7PQgeItu3dOuCJyrzWpoYMsVjkkPEBzbUqw==" crossorigin="anonymous" referrerpolicy="no-referrer"></script>
    <script src="/js/index.js"></script>

    <script>
        // Tax display switcher
        function toggleTaxes(toggleEl) {
            const showWithTax = toggleEl.checked;
            const basePrices = document.querySelectorAll('.base-price');
            const taxPrices = document.querySelectorAll('.tax-price');

            if (showWithTax) {
                basePrices.forEach(el => el.classList.add('d-none'));
                taxPrices.forEach(el => el.classList.remove('d-none'));
            } else {
                basePrices.forEach(el => el.classList.remove('d-none'));
                taxPrices.forEach(el => el.classList.add('d-none'));
            }
        }

        // ==============================================================================
        // Live Search Filter Function (In-Browser Real-Time Search)
        // ==============================================================================
        // Why this is written:
        // Runs on every keystroke as the user types in the search bar.
        // It hides non-matching stay cards instantly without reloading the page.
        function filterMarketplaceListings() {
            // Step 1: Read user input from the search box and make it lowercase
            const mInput = document.getElementById('marketplaceSearchInput');
            const query = (mInput?.value || '').toLowerCase().trim();

            // Step 2: Keep the top navbar search input in sync if user types here
            const navInput = document.getElementById('navbarSearchInput');
            if (navInput && mInput && navInput.value !== mInput.value) {
                navInput.value = mInput.value;
            }

            // Step 3: Find all stay cards currently rendered on the page
            const items = document.querySelectorAll('.listing-item-col');
            let visible = 0;

            // Step 4: Loop through every card and check if title, city, or country matches
            items.forEach(item => {
                const title = item.getAttribute('data-title') || '';
                const location = item.getAttribute('data-location') || '';
                const country = item.getAttribute('data-country') || '';

                // If the stay matches the typed keyword
                if (title.includes(query) || location.includes(query) || country.includes(query)) {
                    item.classList.remove('d-none'); // Show card
                    visible++;
                } else {
                    item.classList.add('d-none');    // Hide card with display: none
                }
            });

            // Step 5: Update the available stays counter badge (e.g. "5 stays available")
            const badge = document.getElementById('listingCountBadge');
            if (badge) {
                badge.textContent = `${visible} stays available`;
            }

            // Step 6: If 0 cards matched, display the "No stays matched your search" message
            const noMatch = document.getElementById('noMatchMessage');
            if (noMatch) {
                if (visible === 0 && items.length > 0) {
                    noMatch.classList.remove('d-none');
                } else {
                    noMatch.classList.add('d-none');
                }
            }
        }

        // Category filter click
        function filterByCategory(category, btnElement) {
            document.querySelectorAll('.category-filter-item').forEach(b => b.classList.remove('active'));
            if (btnElement) btnElement.classList.add('active');

            const searchInput = document.getElementById('marketplaceSearchInput');
            if (searchInput) {
                if (category === 'all') {
                    searchInput.value = '';
                } else {
                    searchInput.value = category;
                }
                filterMarketplaceListings();
            }
        }

        // Wishlist heart toggle
        function toggleFavorite(event, btn) {
            event.preventDefault();
            event.stopPropagation();
            btn.classList.toggle('favorited');
        }
    </script>
</body>
</html>