<!DOCTYPE html>
<html lang="en">
    <%- include("../includes/header.ejs") %>
    <style>
        html,body{
            width: 100%;
            height: 100%;
        }
        .container{
            width: 80%;
            padding-top: 85px;
        }
        .svgdiv{
            /* position: fixed; */
            background-color: white;
            /* z-index: 9999; */
            margin-bottom: 20px;
            height: 460px;
            width: 100%;
            
        }
        .container img{
            width: 100%;
            height: 400px;
        }
        .form{
            /* position: relative; */
            /* top: 470px; */
            /* z-index: 9; */
            padding: 10px;
        }
        
    </style>
<body>
    <%- include("../includes/navbar.ejs") %>
    <div class="container">
        <div class="svgdiv">
            <h2 style="text-align: center;">Create a new Post</h2>
            <img src="/images/newpost.svg" alt="new post">
        </div>
        <div class="form">
            <form method="post" action="/listings" novalidate class="needs-validation" enctype="multipart/form-data">
                    <div class="mb-3 row">
                        <label for="title" class="form-label">Title</label>
                        <input type="text" class="form-control" id="title" placeholder="Enter title" name="title" required>
                        <div class="valid-feedback">Looks good!</div>
                        <div class="invalid-feedback">Title is required!</div>
                    </div>
                    <div class="mb-3 row">
                        <label for="description" class="form-label">Description</label>
                        <textarea type="text" class="form-control" id="description" placeholder="Enter description" name="decription" required></textarea>
                        <div class="valid-feedback">Looks good!</div>
                        <div class="invalid-feedback">Description is required!</div>
                    </div>
                    <div class="mb-3 row">
                        <label for="formFile" class="form-label">Upload image</label>
                        <input class="form-control" type="file" id="formFile" accept="image/*" name="image" required>
                        <div class="valid-feedback">Looks good!</div>
                    </div>
                    <div class="mb-3 row">
                        <label for="price" class="form-label">Price</label>
                        <input type="number" class="form-control" id="price" placeholder="Enter price" name="price" required>
                        <div class="valid-feedback">Looks good!</div>
                        <div class="invalid-feedback">Price is required!</div>
                    </div>
                    <div class="mb-3 row">
                        <label for="location" class="form-label">Location</label>
                        <input type="text" class="form-control" id="location" placeholder="Enter location" name="location" required>
                        <div class="valid-feedback">Looks good!</div>
                        <div class="invalid-feedback">Location is required!</div>
                    </div>
                    <div class="mb-3 row">
                        <label for="country" class="form-label">Country</label>
                        <input type="text" class="form-control" id="country" placeholder="Enter country" name="country" required>
                        <div class="valid-feedback">Looks good!</div>
                        <div class="invalid-feedback">Country is required!</div>
                    </div>
                    
                    <div class="row mb-3">
                        <button type="submit" class="btn btn-success editbtn">Click to Submit!!</button>
                    </div>
            </form>
        </div>
    </div>
    <script src="/js/index.js"></script> 
</body>
</html>