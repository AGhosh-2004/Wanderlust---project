<!DOCTYPE html>
<html lang="en">
<%- include("./includes/header.ejs") %>
<style>
    html,body{
        height: 100%;
    }
    .container
    {
        height: auto;
        width: 500px;
        border: 2px solid crimson;
        position: relative;
        top: 25%;
        border-radius: 20%;
        padding: 2rem;
    }
    /* .container form{
        position: relative;
        top: 50%;
    } */
</style>
<body>
    <div class="container">
        <form method="post" action="/listings/reviews/<%= id %>" novalidate class="needs-validation">
            <div class="mb-3 row">
                <label for="comment" class="form-label">Comment</label>
                <textarea type="text" class="form-control" id="comment" placeholder="Type your comment" name="comment" required></textarea>
                <div class="valid-feedback">Looks good!</div>
                <div class="invalid-feedback">Comment is required!</div>
            </div>
            <div class="mb-3 row">
                <label for="rating" class="form-label">Ratings</label>
                <input type="number" min="1" max="5" class="form-control" id="rating" placeholder="please express your feelings in number" name="rating" required/>
                <div class="valid-feedback">Looks good!</div>
                <div class="invalid-feedback">Please give it!</div>
            </div>

            

            <button type="submit" class="btn btn-outline-danger">Submit your feelings about us!</button>
        </form>   
    </div>         
    <script src="/js/index.js"></script>
</body>
</html>



